{
  "manifest_version": 3,
  "name": "Argos — Fiscal de Preços",
  "version": "0.1.0",
  "description": "Monitore localmente até três produtos do Mercado Livre.",
  "minimum_chrome_version": "109",
  "permissions": ["alarms", "notifications", "offscreen", "storage"],
  "host_permissions": ["https://*.mercadolivre.com.br/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Argos",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*"],
      "js": ["content/mercado-livre.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

