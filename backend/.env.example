# Configuração não sensível para desenvolvimento local.
ARGOS_ENVIRONMENT=development
ARGOS_LOG_LEVEL=INFO
ARGOS_TELEGRAM_WEBHOOK_MAX_BODY_BYTES=65536
ARGOS_TELEGRAM_REQUEST_TIMEOUT_SECONDS=5
ARGOS_TELEGRAM_WORKER_LEASE_SECONDS=30
ARGOS_TELEGRAM_WORKER_RETRY_SECONDS=30

# Segredos devem ser preenchidos apenas no arquivo .env local ou no secret store.
# ARGOS_TELEGRAM_BOT_TOKEN=<defina-fora-do-git>
# ARGOS_TELEGRAM_WEBHOOK_SECRET=<defina-fora-do-git>
# Use postgresql+psycopg e mantenha usuário/senha somente fora do Git.
# Baixe a CA do projeto no Dashboard e monte o arquivo no runtime.
# O usuário de cada URL deve ser uma identidade LOGIN associada ao grupo
# correspondente; os grupos argos_runtime e argos_migrator não fazem login.
# ARGOS_DATABASE_URL=postgresql+psycopg://<usuario_runtime>:<senha>@<host>:5432/<banco>?sslmode=verify-full&sslrootcert=/etc/secrets/argos-supabase-root.crt
# Em produção, migrações usam uma identidade separada:
# ARGOS_MIGRATION_DATABASE_URL=postgresql+psycopg://<usuario_migracao>:<senha>@<host>:5432/<banco>?sslmode=verify-full&sslrootcert=/etc/secrets/argos-supabase-root.crt
